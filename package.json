{
  "name": "brackit",
  "productName": "Brackit",
  "version": "0.2.0",
  "description": "Review Fujifilm film-simulation brackets side by side and pick the look you want.",
  "license": "MIT",
  "author": "Lawrence Lee",
  "repository": "github:lawrenceleejr/brackit",
  "scripts": {
    "build:cli": "cargo build --release --no-default-features --manifest-path src-tauri/Cargo.toml",
